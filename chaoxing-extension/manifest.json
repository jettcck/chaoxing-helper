{
  "manifest_version": 3,
  "name": "学习通刷课助手",
  "version": "1.6.0",
  "description": "学习通课程视频自动播放、一键倍速、接入大模型自动答题、自动下一节。",
  "permissions": ["storage", "webNavigation"],
  "host_permissions": [
    "*://*.chaoxing.com/*",
    "*://chaoxing.com/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "学习通刷课助手"
  },
  "web_accessible_resources": [
    {
      "resources": ["question_bank.json"],
      "matches": ["*://*.chaoxing.com/*", "*://chaoxing.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://*.chaoxing.com/*", "*://chaoxing.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
